# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc "Build, sign, and upload Velanera to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_BASE64"] == "true",
      duration: 1200,
      in_house: false
    )

    increment_build_number(
      xcodeproj: "Velanera.xcodeproj",
      build_number: ENV["VELANERA_BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Velanera.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: ENV.fetch("VELANERA_BUNDLE_ID", "co.velanera.app"),
      profile_name: nil,
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      project: "Velanera.xcodeproj",
      scheme: "Velanera",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Velanera",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Velanera guest app beta."
    )
  end

  desc "Archive locally without uploading (sanity check)"
  lane :build_only do
    build_app(
      project: "Velanera.xcodeproj",
      scheme: "Velanera",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Velanera",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
    )
  end
end
